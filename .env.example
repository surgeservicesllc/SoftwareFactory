# SoftwareFactory environment template
# Copy to .env.local and keep real values out of source control.
# Empty values mean the associated live integration is Not Connected.

# Browser-public application URL used for absolute metadata links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser-public Supabase configuration (not privileged; RLS is mandatory)
NEXT_PUBLIC_SUPABASE_URL=
# Server-only identity expected behind NEXT_PUBLIC_SUPABASE_URL. Health fails
# closed when the configured hostname does not match this exact project ref.
SOFTWAREFACTORY_EXPECTED_SUPABASE_PROJECT_REF=
# Server-only immutable Vercel/project and public-alias identity. Health is
# unavailable unless the current deployment and request match both exactly.
SOFTWAREFACTORY_EXPECTED_VERCEL_PROJECT_ID=
SOFTWAREFACTORY_EXPECTED_PRODUCTION_HOST=
# Preferred client credential.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback accepted by the client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Comma-separated email addresses granted the super-administrator
# role. Setting this REPLACES the repository default list rather than adding to
# it. An address only takes effect once Supabase reports it as confirmed, so an
# unconfirmed sign-up can never claim the role. Never prefix with NEXT_PUBLIC_.
SUPER_ADMIN_EMAILS=

# Server-only Supabase credential used only by verified GitHub webhook and
# narrowly audited terminal-evidence/recovery boundaries. Interactive reads,
# onboarding, project linking, and change reservation use the caller's JWT/RLS.
# Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Local/CI migration tooling only; do not expose at application runtime.
# SUPABASE_ACCESS_TOKEN is a personal access token from
# https://supabase.com/dashboard/account/tokens and begins with `sbp_`. It is
# not a project API key: `sb_secret_`/service-role keys reach the Data API only
# and cannot read or change project configuration.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=

# Supabase Auth custom SMTP, consumed by `supabase config push` through the
# env() references in supabase/config.toml. These configure Supabase's mailer;
# the application itself never reads them and never sends mail directly.
# Required because auth.email.enable_confirmations is true and the built-in
# mail service cannot deliver to end users.
SUPABASE_AUTH_SMTP_HOST=
SUPABASE_AUTH_SMTP_PORT=587
SUPABASE_AUTH_SMTP_USER=
SUPABASE_AUTH_SMTP_PASS=
SUPABASE_AUTH_SMTP_SENDER_NAME=
# From address; its domain must be verified with the provider.
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=

# Production GitHub App integration. All values are server-only.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/github/install/callback
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_STATE_SECRET=

# Optional bounded replacement/candidate App. Leave every value empty when no
# handoff is in progress. When used, configure the complete bundle, use exactly
# one candidate private-key representation, and keep every identity/secret
# distinct from the primary App. Never expose these through NEXT_PUBLIC_*.
GITHUB_CANDIDATE_APP_ID=
GITHUB_CANDIDATE_APP_CLIENT_ID=
GITHUB_CANDIDATE_APP_CLIENT_SECRET=
GITHUB_CANDIDATE_APP_PRIVATE_KEY=
GITHUB_CANDIDATE_APP_PRIVATE_KEY_BASE64=
GITHUB_CANDIDATE_APP_SLUG=
GITHUB_CANDIDATE_APP_CALLBACK_URL=
GITHUB_CANDIDATE_APP_WEBHOOK_SECRET=
GITHUB_CANDIDATE_APP_STATE_SECRET=

# GitHub Actions does not permit secret names beginning with GITHUB_. Store the
# worker copies as SOFTWAREFACTORY_GITHUB_APP_ID,
# SOFTWAREFACTORY_GITHUB_APP_PRIVATE_KEY_BASE64, and candidate variants. The
# workflow maps them to the runtime names above. It never receives OAuth
# client, state, or webhook secrets.

# Phase 1C Codex worker. Keep every value server-side. The worker remains OFF
# unless it is running in a dedicated persistent process or reviewed one-shot
# CI job; Vercel request handlers do not execute Codex work.
SOFTWAREFACTORY_WORKER_ENABLED=false
SOFTWAREFACTORY_WORKER_ID=
SOFTWAREFACTORY_WORK_ROOT=
SOFTWAREFACTORY_WORKER_POLL_MS=5000
SOFTWAREFACTORY_WORKER_HEARTBEAT_MS=10000
SOFTWAREFACTORY_CODEX_MODEL=gpt-5.3-codex
SOFTWAREFACTORY_REQUIRED_CHECKS=Lint, typecheck, test, and build|Browser and accessibility tests 1/3|Browser and accessibility tests 2/3|Browser and accessibility tests 3/3
SOFTWAREFACTORY_WORKER_RUNTIME=docker
# Non-secret one-shot claim identity. Repository/manual dispatch sets both;
# schedules leave the target empty and the required guard false. Setting the
# guard true without an exact command UUID makes the worker fail before claim.
SOFTWAREFACTORY_TARGET_COMMAND_ID=
SOFTWAREFACTORY_TARGET_CLAIM_REQUIRED=false
SOFTWAREFACTORY_TARGET_GRAPH_ID=

# Global fail-closed gate for every graph-worker trigger. The separate
# scheduled gate cannot bypass this value.
SOFTWAREFACTORY_PHASE1C_WORKER_ENABLED=false
SOFTWAREFACTORY_GRAPH_WORKER_ENABLED=false
SOFTWAREFACTORY_GRAPH_WORKER_SCHEDULED=false

# How Codex authenticates. The worker will not start without this.
#
# Phase 1C consumes no per-token AI API credit. Codex runs on the owner's
# existing ChatGPT plan: run `codex login` on a machine signed in to that
# account, complete the browser flow, and put the whole contents of
# ~/.codex/auth.json here as a single-line JSON string. It carries OAuth tokens,
# so it is secret material and belongs in a server-side secret store — in CI,
# the repository secret of the same name.
#
# A file written by `codex login --api-key` is rejected: it bills per token, and
# the worker refuses it rather than billing silently under a name that says
# subscription.
SOFTWAREFACTORY_CODEX_AUTH_JSON=

# Leave unset. `subscription` is the default and the only zero-token mode.
# Setting this to `api_key` opts in to per-token billing deliberately, and is
# the only way OPENAI_API_KEY below is ever read by the worker.
SOFTWAREFACTORY_CODEX_AUTH_MODE=

# The commit identity the worker signs factory commits with. Both are required
# and validated before any authorization, persistence, token minting, or
# provider mutation; there is no App-bot fallback. Public values, not secrets.
GITHUB_COMMIT_IDENTITY_NAME=
GITHUB_COMMIT_IDENTITY_EMAIL=

# Server-only AES-256-GCM key sealing AI-account provider credentials in the
# vault (provider_credentials). Used by the auth-broker worker and the
# server-side vault boundary; never browser-visible, never logged. In CI it is
# the repository secret of the same name. Generate 32 random bytes, base64.
SOFTWAREFACTORY_CREDENTIAL_KEY=

# Stripe subscription billing. All server-only; leaving them empty renders
# every billing surface honestly as Not Connected. The publishable key is
# deliberately absent from this codebase: Checkout and the customer portal are
# Stripe-hosted pages reached by redirect, so no Stripe key of any kind ships
# to the browser. Price ids come from the Stripe dashboard after creating the
# Basic and Pro products (docs/BILLING_GO_LIVE.md is the exact runbook).
# The webhook route also requires SUPABASE_SERVICE_ROLE_KEY above — it is the
# second verified-webhook writer, after GitHub's.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Deployment integration remains disconnected.
VERCEL_TOKEN=

# Bot fabric credential references. A bot record stores only the NAME of one of
# these variables; the value is read server-side to answer "is this populated?"
# and is never returned to the browser, written to a table, or logged. Setting a
# value here makes a bot "Ready to assign" — it does not connect a worker, and no
# executor runs assigned work in this phase.
#
# Name your own references as BOT_CREDENTIAL_<NAME> for endpoints not listed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
BOT_CREDENTIAL_CUSTOM=

# Job Search alert engine. All server-only; the alert controls on
# /JobSearch render as "Not Connected" until an email transport exists, and
# the scheduled runner refuses every request while CRON_SECRET is unset.
# RESEND_API_KEY: an API key from resend.com; JOB_ALERT_EMAIL_FROM: a from
# address on a domain verified with Resend; CRON_SECRET: any long random
# value — Vercel sends it as the bearer on cron invocations of
# /api/job-seeker/alerts/run.
# JOB_ALERT_SMTP_URL (development stacks only): plain smtp://host:port
# pointing at the local Supabase stack's Mailpit sink, so the acceptance
# lane can verify a real delivery. No TLS, no auth — never production.
# Resend wins when both transports are set.
RESEND_API_KEY=
JOB_ALERT_EMAIL_FROM=
JOB_ALERT_SMTP_URL=
CRON_SECRET=
