# SoftwareFactory environment template
# Copy to .env.local and keep real values out of source control.
# Empty values mean the associated live integration is Not Connected.

# Browser-public application URL used for absolute metadata links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser-public Supabase configuration (not privileged; RLS is mandatory)
NEXT_PUBLIC_SUPABASE_URL=
# Preferred client credential.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback accepted by the client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential used only by the verified GitHub webhook
# boundary. Interactive handlers still use the caller's JWT and RLS.
# Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Local/CI migration tooling only; do not expose at application runtime.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=

# Production GitHub App integration. All values are server-only.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/github/install/callback
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_STATE_SECRET=

# Phase 1C worker provider. Server-only; never prefix with NEXT_PUBLIC_.
# Without this value the Codex worker reports Not Connected and no run starts.
OPENAI_API_KEY=
# Optional. Defaults to https://api.openai.com/v1 and must use HTTPS.
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=

# Durable worker tick credential. A scheduler presents it as a bearer token to
# /api/worker/tick. Must be at least 32 bytes. Vercel Cron sends CRON_SECRET
# automatically, so setting either is sufficient.
WORKER_TICK_SECRET=
CRON_SECRET=

# Deployment and later-phase provider integrations remain disconnected.
VERCEL_TOKEN=
ANTHROPIC_API_KEY=
