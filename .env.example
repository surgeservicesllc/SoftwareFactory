# SoftwareFactory environment template
# Copy to .env.local and keep real values out of source control.
# Empty values mean the associated live integration is Not Connected.

# Browser-public application URL used for absolute metadata links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser-public Supabase configuration (not privileged; RLS is mandatory)
NEXT_PUBLIC_SUPABASE_URL=
# Preferred client credential.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback accepted by the client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential used only by verified GitHub webhook and
# narrowly audited terminal-evidence/recovery boundaries. Interactive reads,
# onboarding, project linking, and change reservation use the caller's JWT/RLS.
# Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Local/CI migration tooling only; do not expose at application runtime.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=

# Production GitHub App integration. All values are server-only.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/github/install/callback
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_STATE_SECRET=

# Optional bounded replacement/candidate App. Leave every value empty when no
# handoff is in progress. When used, configure the complete bundle, use exactly
# one candidate private-key representation, and keep every identity/secret
# distinct from the primary App. Never expose these through NEXT_PUBLIC_*.
GITHUB_CANDIDATE_APP_ID=
GITHUB_CANDIDATE_APP_CLIENT_ID=
GITHUB_CANDIDATE_APP_CLIENT_SECRET=
GITHUB_CANDIDATE_APP_PRIVATE_KEY=
GITHUB_CANDIDATE_APP_PRIVATE_KEY_BASE64=
GITHUB_CANDIDATE_APP_SLUG=
GITHUB_CANDIDATE_APP_CALLBACK_URL=
GITHUB_CANDIDATE_APP_WEBHOOK_SECRET=
GITHUB_CANDIDATE_APP_STATE_SECRET=

# GitHub Actions does not permit secret names beginning with GITHUB_. Store the
# worker copies as SOFTWAREFACTORY_GITHUB_APP_ID,
# SOFTWAREFACTORY_GITHUB_APP_PRIVATE_KEY_BASE64, and candidate variants. The
# workflow maps them to the runtime names above. It never receives OAuth
# client, state, or webhook secrets.

# Phase 1C Codex worker. Keep every value server-side. The worker remains OFF
# unless it is running in a dedicated persistent process or reviewed one-shot
# CI job; Vercel request handlers do not execute Codex work.
SOFTWAREFACTORY_WORKER_ENABLED=false
SOFTWAREFACTORY_WORKER_ID=
SOFTWAREFACTORY_WORK_ROOT=
SOFTWAREFACTORY_WORKER_POLL_MS=5000
SOFTWAREFACTORY_WORKER_HEARTBEAT_MS=10000
SOFTWAREFACTORY_CODEX_MODEL=gpt-5.3-codex
SOFTWAREFACTORY_REQUIRED_CHECKS=Lint, typecheck, test, and build|Browser and accessibility tests
SOFTWAREFACTORY_WORKER_RUNTIME=docker

# Deployment integration remains disconnected.
VERCEL_TOKEN=

# Bot fabric credential references. A bot record stores only the NAME of one of
# these variables; the value is read server-side to answer "is this populated?"
# and is never returned to the browser, written to a table, or logged. Setting a
# value here makes a bot "Ready to assign" — it does not connect a worker, and no
# executor runs assigned work in this phase.
#
# Name your own references as BOT_CREDENTIAL_<NAME> for endpoints not listed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
BOT_CREDENTIAL_CUSTOM=
